{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Windows: Visual Studio 2022, C++ tests",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "gcc-asan",
      "displayName": "Linux: GCC with AddressSanitizer and UBSan, C++ tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "AEGIS_SANITIZE": "ON" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "gcc-asan", "configurePreset": "gcc-asan" }
  ],
  "testPresets": [
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "gcc-asan", "configurePreset": "gcc-asan", "output": { "outputOnFailure": true } }
  ]
}
